{
  "name": "robviz",
  "private": true,
  "version": "0.1.0",
  "description": "Web 机器人上位机：浏览器直连 foxglove_bridge 的 rviz/rqt 替代品，含 3D 可视化、地图/点云编辑、布局配置与插件系统",
  "license": "MIT",
  "author": "Edmounds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edmounds/robviz.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ui:preview": "vite --config vite.ui.config.ts --open /ui.html",
    "build": "tsc -b && vite build",
    "sdk:build": "tsc -p tsconfig.sdk.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "terminal": "tsx terminal/server.ts",
    "test": "vitest run",
    "plugin:new": "tsx scripts/new-plugin.ts",
    "plugins:scan": "tsx scripts/index-plugins.ts"
  },
  "dependencies": {
    "@foxglove/rosmsg": "^5.0.5",
    "@foxglove/rosmsg2-serialization": "^3.1.2",
    "@foxglove/ws-protocol": "^0.8.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-react": "^8.1.0",
    "lucide-react": "^1.31.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
